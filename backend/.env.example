# Database Connection
# For PostgreSQL: postgresql://username:password@localhost:5432/coopconnect
# For SQLite (default zero-configuration local mode): sqlite:///./coopconnect.db
DATABASE_URL=sqlite:///./coopconnect.db

# JWT Authentication
SECRET_KEY=coopconnect-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
